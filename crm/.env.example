# Скопируйте в .env и заполните. Файл .env в git не попадает.

# --- Общее ---
APP_ENV=local
APP_URL=http://localhost:8796
APP_TIMEZONE=Asia/Tomsk

# Пусто — SQLite в storage/database.sqlite (и локально, и на хостинге: заявок немного, pdo_sqlite на хостинге есть).
# MySQL при желании: DB_DSN=mysql:host=localhost;dbname=...;charset=utf8mb4
DB_DSN=
DB_USER=
DB_PASS=

# --- Автошкола ---
SCHOOL_PHONE=+73822345252
WORK_DAYS=1-5
WORK_HOURS=09:00-18:00

# --- Заявки: общее ---
# Случайная строка (32+ символа) для подписи ссылок «Написать в MAX». Сгенерировать:
#   php -r "echo bin2hex(random_bytes(24));"
LEADS_SECRET=
# Если форма стоит на другом домене, перечислите его через запятую (сайт и CRM Виража — на одном домене, можно пусто):
# LEADS_ALLOWED_ORIGINS=https://virazh-tomsk.ru
LEADS_ALLOWED_ORIGINS=

# Первый номер заявки: продолжаем счётчик старого сайта (counter.txt Joomla был 423 на 10.11.2026 — при переносе свериться)
LEADS_FIRST_ID=424

# --- Заявки: письмо о заявке на почту (тема «ID: N. Новая заявка с сайта Вираж», как от send-form.php) ---
# MAIL_DRIVER=log пишет письма в storage/logs/mail.log; на хостинге MAIL_DRIVER=mail (встроенный mail()).
MAIL_DRIVER=log
MAIL_TO=virazh-tomsk@yandex.ru
MAIL_FROM=virazh-tomsk@yandex.ru

# --- Заявки: оповещение в Telegram без персональных данных (номер, услуга, ссылка в админку) ---
# TELEGRAM_DRIVER=log пишет в storage/logs/telegram.log; на хостинге TELEGRAM_DRIVER=http.
# Как получить токен и ID чата — cron/README.md. Пустой токен — не шлём.
TELEGRAM_DRIVER=log
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_CA_FILE=

# --- Чат-бот на нейросети (DeepSeek). У Виража не используется: свой помощник на готовых ответах (assets/js/bot.js). ---
# Пусто — выключен, пункта «Чат» в админке нет.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# Сколько ответов ИИ в сутки на весь сайт (защита бюджета)
CHAT_DAILY_LIMIT=500
DEEPSEEK_CA_FILE=

# --- Заявки: SMS. У Виража пока НЕ подключены: SMS_DRIVER=off — ничего не отправляется и в истории не пишется. ---
# Подключить: SMS_DRIVER=p1sms (или smsru) и APP_ENV=production; log — писать SMS в storage/logs вместо отправки (проверка).
# SMS уходят только на мобильные номера; заявки с городских номеров принимаются, но без SMS.
# P1SMS: ключ — Профиль → «API и интеграции»; SMS_SENDER — имя из «Список отправителей» (общее INFO или своё);
# SMS_CHANNEL=char — буквенный отправитель, digit — цифровой номер (дешевле, но доставка хуже).
# SMS.ru: SMS_TEST=1 — проверяет запрос, но не отправляет.
SMS_DRIVER=off
SMS_API_KEY=
SMS_SENDER=INFO
SMS_CHANNEL=char
SMS_TEST=
# Путь к файлу сертификатов, если хостинг пишет «unable to get local issuer certificate»
SMS_CA_FILE=

# --- Заявки: бот MAX (driver=log — без реальных запросов к MAX) ---
# Реальные запросы: MAX_DRIVER=http и APP_ENV=production.
MAX_DRIVER=log
MAX_BOT_TOKEN=
# Имя бота из ссылки max.ru/имя — без него кнопка «Написать в MAX» не показывается
MAX_BOT_NAME=
# ID чата «Заявки»: бот пишет его, когда его добавляют в чат (можно задать и в настройках админки)
MAX_ADMIN_CHAT_ID=
# Секрет вебхука: 5–256 символов, только латиница, цифры, _ и -
MAX_WEBHOOK_SECRET=
MAX_API_URL=https://platform-api2.max.ru
# Путь к сертификату Минцифры, если хостинг ему не доверяет
MAX_CA_FILE=

# --- Защита формы: Яндекс SmartCaptcha (пусто — капча отключена) ---
SMARTCAPTCHA_CLIENT_KEY=
SMARTCAPTCHA_SERVER_KEY=

# --- Сайт ---
YANDEX_METRIKA_ID=
